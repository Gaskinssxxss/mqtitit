# Salin file ini menjadi config.env, lalu sesuaikan nilainya.

# Harus sama dengan konfigurasi Windows dan Ubuntu Server A.
RUN_ID=run01_normal
SCENARIO=normal
EXPERIMENT_DURATION=60
DEPLOYMENT_MODE=local
OUTPUT_DIR=experiments

# Target adalah IP Ubuntu Server A dan port Mosquitto.
BROKER_HOST=192.168.56.10
MQTT_PORT=1883

# Jumlah paket SYN per detik.
ATTACK_RATE=1000

# Pengaman wajib. Gunakan yes hanya pada testbed sendiri/berizin.
I_UNDERSTAND_AUTHORIZED_TESTBED=no

# Wajib yes untuk mode campus/public yang memiliki izin tertulis.
I_HAVE_WRITTEN_AUTHORIZATION=no
