# Salin file ini menjadi config.env, lalu sesuaikan nilainya.

# Harus sama dengan konfigurasi Windows dan Ubuntu Server B.
RUN_ID=run01_normal
SCENARIO=normal
EXPERIMENT_DURATION=60
# Capture dibuat lebih panjang agar seluruh proses client dan attacker terekam.
CAPTURE_DURATION=75
DEPLOYMENT_MODE=local
OUTPUT_DIR=experiments

# Alamat tujuan yang digunakan Windows dan attacker.
BROKER_HOST=192.168.56.10
MQTT_PORT=1883
MQTT_TOPIC=unram/iot/suhu

# Alamat dan interface yang benar-benar terlihat pada Ubuntu Server A.
BROKER_CAPTURE_HOST=192.168.56.10
BROKER_IFACE=enp0s8

# Nilai rate limiting untuk skenario syn_flood_rate_limit.
RL_RATE=50/second
RL_BURST=100

# Dicatat ke metadata agar konfigurasi satu run lengkap.
MQTT_QOS=1
MQTT_INTERVAL_MS=1000
MQTT_TIMEOUT_SEC=5
ATTACK_RATE=1000
