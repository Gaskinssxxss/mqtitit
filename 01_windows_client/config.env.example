# Salin file ini menjadi config.env, lalu sesuaikan nilainya.

# RUN_ID harus sama dengan RUN_ID pada Ubuntu Server A.
# Gunakan RUN_ID baru untuk setiap pengulangan pengujian.
RUN_ID=run01_normal
SCENARIO=normal
EXPERIMENT_DURATION=60
DEPLOYMENT_MODE=local

# Alamat Ubuntu Server A yang dapat diakses dari Windows.
BROKER_HOST=192.168.56.10
MQTT_PORT=1883
MQTT_TOPIC=unram/iot/suhu

MQTT_CLIENT_ID_PREFIX=unram-test
MQTT_QOS=1
MQTT_INTERVAL_MS=1000
MQTT_TIMEOUT_SEC=5
ATTACK_RATE=1000
OUTPUT_DIR=experiments
